<?xml version="1.0"?>

<sdf version="1.10">

    <world name="tcc">

        <!-- Gravidade -->
        <gravity>0 0 -9.81</gravity>

        <!-- Chao -->
        <model name="ground">

            <static>true</static>

            <link name="link">

                <collision name="collision">

                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                </collision>

                <visual name="visual">

                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>

                </visual>

            </link>

        </model>

        <!-- Luz -->
        <light name="sun"
               type="directional">

            <pose>0 0 10 0 0 0</pose>

            <direction>-0.5 0.5 -1</direction>

            <diffuse>1 1 1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>

        </light>

        <!-- Drone -->
        <include>
            <uri>model://drone</uri>
        </include>

        <!-- Armadilha -->
        <include>
            <uri>model://armadilha</uri>
        </include>

    </world>

</sdf>
