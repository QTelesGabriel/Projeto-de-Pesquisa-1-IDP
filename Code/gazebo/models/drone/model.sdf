<?xml version="1.0"?>

<sdf version="1.10">

    <model name="drone">

        <static>false</static>

        <!-- Posição inicial do drone -->
        <pose>2 0 2 0 0 0</pose>

        <link name="body">

            <!-- ==================== -->
            <!-- VISUAL                -->
            <!-- ==================== -->

            <visual name="visual">

                <geometry>
                    <mesh>
                        <uri>model://drone/meshes/corpo.STL</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>

                <material>
                    <ambient>0.03 0.03 0.03 1</ambient>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                    <specular>0.01 0.01 0.01 1</specular>
                </material>

            </visual>


            <!-- ==================== -->
            <!-- COLLISION              -->
            <!-- ==================== -->

            <collision name="body_collision">

                <pose>0 0 0.15 0 0 0</pose>

                <geometry>
                    <box>
                        <size>0.9 0.9 0.3</size>
                    </box>
                </geometry>

            </collision>


            <!-- ==================== -->
            <!-- MASSA                  -->
            <!-- ==================== -->

            <inertial>

                <mass>7.0</mass>

                <!-- Valores provisórios -->
                <inertia>
                    <ixx>1.0</ixx>
                    <iyy>1.0</iyy>
                    <izz>1.0</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>

            </inertial>

        </link>

    </model>

</sdf>
