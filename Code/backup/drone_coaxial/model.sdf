    <link name="rotor_4_inf">
      <pose>-0.40006 -0.40476 0.00581 0 0 0</pose>
      <inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="r4_inf_vis">
        <geometry><mesh><uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
