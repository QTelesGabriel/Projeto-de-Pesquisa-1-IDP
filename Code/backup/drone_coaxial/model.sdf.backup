<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="drone_coaxial">
    <pose>0 0 0.45 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose> 
        <mass>6.61807</mass>
        <inertia>
          <ixx>1.157708</ixx><ixy>0.019616</ixy><ixz>-0.003706</ixz> 
          <iyy>0.648936</iyy><iyz>-0.101083</iyz><izz>1.569346</izz> 
        </inertia>
      </inertial>

      <visual name="corpo_visual">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/montagem-drone-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="corpo_colisao">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/montagem-drone-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
      </sensor>
    </link>

    <!-- BRAÇO 1 -->
    <link name="rotor_1_sup"><pose>0.40006 0.40476 0.09529 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r1_sup_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_1_sup_joint" type="revolute"><child>rotor_1_sup</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="rotor_1_inf"><pose>0.40006 0.40476 0.00581 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r1_inf_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_1_inf_joint" type="revolute"><child>rotor_1_inf</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>

    <!-- BRAÇO 2 -->
    <link name="rotor_2_sup"><pose>0.40006 -0.40476 0.09529 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r2_sup_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_2_sup_joint" type="revolute"><child>rotor_2_sup</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="rotor_2_inf"><pose>0.40006 -0.40476 0.00581 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r2_inf_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_2_inf_joint" type="revolute"><child>rotor_2_inf</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>

    <!-- BRAÇO 3 -->
    <link name="rotor_3_sup"><pose>-0.40006 0.40476 0.09529 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r3_sup_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_3_sup_joint" type="revolute"><child>rotor_3_sup</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="rotor_3_inf"><pose>-0.40006 0.40476 0.00581 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r3_inf_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_3_inf_joint" type="revolute"><child>rotor_3_inf</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>

    <!-- BRAÇO 4 -->
    <link name="rotor_4_sup"><pose>-0.40006 -0.40476 0.09529 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r4_sup_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_4_sup_joint" type="revolute"><child>rotor_4_sup</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>
    <link name="rotor_4_inf"><pose>-0.40006 -0.40476 0.00581 0 0 0</pose><inertial><mass>0.05</mass><inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0005</izz></inertia></inertial><visual name="r4_inf_vis"><geometry><mesh><uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry></visual></link>
    <joint name="rotor_4_inf_joint" type="revolute"><child>rotor_4_inf</child><parent>base_link</parent><axis><xyz>0 0 1</xyz></axis></joint>

    <!-- TENDÕES (Obrigatório para o Gazebo aceitar força na joint) -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_4_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_4_inf_joint</joint_name></plugin>

    <!-- A VERDADEIRA FÍSICA: LIFTDRAG DUPLO (DUAS PÁS POR ROTOR PARA EVITAR VIBRAÇÃO) -->
    
    <!-- ================= BRAÇO 1 (Frente-Esquerda) ================= -->
    <!-- SUP: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1_sup</link_name>
    </plugin>
    <!-- INF: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 2 (Frente-Direita) ================= -->
    <!-- SUP: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2_sup</link_name>
    </plugin>
    <!-- INF: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 3 (Atrás-Esquerda) ================= -->
    <!-- SUP: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3_sup</link_name>
    </plugin>
    <!-- INF: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 4 (Atrás-Direita) ================= -->
    <!-- SUP: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_4_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_4_sup</link_name>
    </plugin>
    <!-- INF: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>0.084 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_4_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.10</cda><cma>0.0</cma><area>0.005</area><air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_4_inf</link_name>
    </plugin>

    <!-- O CÉREBRO: ARDUPILOT COM MAPEAMENTO OCTAQUAD X E PIDs ULTRARRÁPIDOS -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>

      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 0</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <!-- CANAL 0: Motor 1 (Frente-Direita Sup) | CCW -->
      <control channel="0"><jointName>rotor_2_sup_joint</jointName><useForce>1</useForce><multiplier>800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 1: Motor 2 (Atrás-Esquerda Sup) | CCW -->
      <control channel="1"><jointName>rotor_3_sup_joint</jointName><useForce>1</useForce><multiplier>800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 2: Motor 3 (Frente-Esquerda Sup) | CW -->
      <control channel="2"><jointName>rotor_1_sup_joint</jointName><useForce>1</useForce><multiplier>-800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 3: Motor 4 (Atrás-Direita Sup) | CW -->
      <control channel="3"><jointName>rotor_4_sup_joint</jointName><useForce>1</useForce><multiplier>-800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 4: Motor 5 (Frente-Esquerda Inf) | CCW -->
      <control channel="4"><jointName>rotor_1_inf_joint</jointName><useForce>1</useForce><multiplier>800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 5: Motor 6 (Atrás-Direita Inf) | CCW -->
      <control channel="5"><jointName>rotor_4_inf_joint</jointName><useForce>1</useForce><multiplier>800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 6: Motor 7 (Frente-Direita Inf) | CW -->
      <control channel="6"><jointName>rotor_2_inf_joint</jointName><useForce>1</useForce><multiplier>-800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
      
      <!-- CANAL 7: Motor 8 (Atrás-Esquerda Inf) | CW -->
      <control channel="7"><jointName>rotor_3_inf_joint</jointName><useForce>1</useForce><multiplier>-800</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>1900</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>3.0</cmd_max><cmd_min>-3.0</cmd_min><controlVelocitySlowdownSim>1</controlVelocitySlowdownSim></control>
    </plugin>
  </model>
</sdf>