<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="drone_coaxial">
    <pose>0 0 0.45 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose> 
        <!-- Massa total: 6.300 kg da base + 8 rotores de 0.050 kg = 6.700 kg. -->
        <mass>6.30000</mass>
        <inertia>
          <ixx>0.903322</ixx><ixy>0</ixy><ixz>0</ixz> 
          <iyy>0.903322</iyy><iyz>0</iyz><izz>1.569346</izz> 
        </inertia>
      </inertial>

      <visual name="corpo_visual">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/montagem-drone-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="corpo_colisao">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/montagem-drone-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <sensor name="imu_sensor" type="imu">
        <!-- O plugin ArduPilot usa corpo X-forward/Y-right/Z-down. -->
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>

    <!-- ============================================== -->
    <!-- GIMBAL E CÂMERA SIYI A8 MINI (3 Eixos)         -->
    <!-- ============================================== -->
    
    <!-- 1. Yaw Link -->
    <link name="gimbal_yaw_link">
      <pose>0.00057 -0.04216 -0.04551 0 0 0</pose>
      <inertial>
        <mass>0.030</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
    </link>
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent>base_link</parent>
      <child>gimbal_yaw_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-2.7925</lower><upper>2.7925</upper></limit></axis>
    </joint>

    <!-- 2. Roll Link -->
    <link name="gimbal_roll_link">
      <pose>0.00057 -0.04216 -0.04551 0 0 0</pose>
      <inertial>
        <mass>0.030</mass>
        <inertia><ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00001</iyy><iyz>0</iyz><izz>0.00001</izz></inertia>
      </inertial>
    </link>
    <joint name="gimbal_roll_joint" type="revolute">
      <parent>gimbal_yaw_link</parent>
      <child>gimbal_roll_link</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.5236</lower><upper>0.5236</upper></limit></axis>
    </joint>

    <!-- 3. Pitch Link e Câmera -->
    <link name="camera_pitch_link">
      <pose>0.00057 -0.04216 -0.04551 0 0 0</pose>
      <inertial>
        <mass>0.035</mass>
        <inertia><ixx>0.00002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00002</iyy><iyz>0</iyz><izz>0.00002</izz></inertia>
      </inertial>
      
      <visual name="camera_visual">
        <geometry><mesh><uri>model://drone_coaxial/meshes/camera-corrigida.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
      
      <collision name="camera_collision">
        <!-- Bounding box exato da Siyi A8 Mini (55x55x70 mm) -->
        <geometry><box><size>0.055 0.055 0.070</size></box></geometry>
      </collision>

      <sensor name="siyi_a8_mini_sensor" type="camera">
        <!-- O "olho" da câmera fica exatamente na borda inferior da caixa -->
        <pose degrees="true">0 0 -0.035 0 90 0</pose>
        <camera>
          <horizontal_fov>1.4137</horizontal_fov>
          
          <!-- RESOLUÇÃO ALTERADA PARA FULL HD (1080p) -->
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          
          <clip><near>0.01</near><far>1000</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>camera/image</topic>
      </sensor>
    </link>
    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>gimbal_roll_link</parent>
      <child>camera_pitch_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-2.3562</lower><upper>0.7854</upper></limit></axis>
    </joint>

    <!-- Plugins de Força para o Gimbal -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>gimbal_yaw_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>gimbal_roll_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>gimbal_pitch_joint</joint_name></plugin>

    <!-- ============================================== -->
    <!-- ROTORES DO DRONE                               -->
    <!-- ============================================== -->

    <!-- BRAÇO 1 -->
    <link name="rotor_1_sup">
      <pose>0.40006 0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r1_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_sup_joint" type="revolute">
      <child>rotor_1_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_1_inf">
      <pose>0.40006 0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r1_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_inf_joint" type="revolute">
      <child>rotor_1_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- BRAÇO 2 -->
    <link name="rotor_2_sup">
      <pose>0.40006 -0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r2_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
