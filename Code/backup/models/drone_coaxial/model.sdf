<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="drone_coaxial">
    <pose>0 0 0.45 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose> 
        <!-- Massa total: 6.300 kg da base + 8 rotores de 0.050 kg = 6.700 kg. -->
        <mass>6.30000</mass>
        <inertia>
          <ixx>0.903322</ixx><ixy>0</ixy><ixz>0</ixz> 
          <iyy>0.903322</iyy><iyz>0</iyz><izz>1.569346</izz> 
        </inertia>
      </inertial>

      <visual name="corpo_visual">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/montagem-drone-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <collision name="corpo_colisao">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/montagem-drone-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <sensor name="imu_sensor" type="imu">
        <!-- O plugin ArduPilot usa corpo X-forward/Y-right/Z-down. -->
        <pose degrees="true">0 0 0 180 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
      </sensor>
    </link>

    <!-- ============================================== -->
    <!-- GIMBAL SIYI A8 MINI DE 3 EIXOS                 -->
    <!-- ============================================== -->
    
    <!-- A massa total dos tres links e 0.095 kg, conforme a ficha da A8 Mini. -->
    <!-- 1. Estagio de yaw e suporte preso ao drone -->
    <link name="gimbal_yaw_link">
      <pose>0.00057 -0.04216 -0.04551 0 0 0</pose>
      <inertial>
        <mass>0.025</mass>
        <inertia><ixx>0.0000051</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000051</iyy><iyz>0</iyz><izz>0.0000084</izz></inertia>
      </inertial>

      <!-- O bloco e somente o suporte superior. Ele acompanha yaw, mas nao
           inclina junto com roll/pitch nem prende a camera ao corpo. -->
      <visual name="suporte_gimbal_visual">
        <!-- Posição levemente mais alta (0.035) para acomodar o tamanho maior -->
        <pose>0 0 0.035 0 0 0</pose>
        <geometry>
          <!-- Tamanho aumentado para 6x6 cm de largura e 3 cm de altura -->
          <box><size>0.060 0.060 0.030</size></box>
        </geometry>
        <material>
          <!-- Tom Preto Fosco (Matte Black) -->
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent>base_link</parent>
      <child>gimbal_yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <!-- A8 Mini: -160 a +160 graus. -->
        <limit><lower>-2.792526803</lower><upper>2.792526803</upper></limit>
        <dynamics><damping>0.02</damping><friction>0.005</friction></dynamics>
      </axis>
    </joint>

    <!-- 2. Estagio de roll -->
    <link name="gimbal_roll_link">
      <pose>0.00057 -0.04216 -0.04551 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>0.0000020</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000020</iyy><iyz>0</iyz><izz>0.0000020</izz></inertia>
      </inertial>
    </link>
    <joint name="gimbal_roll_joint" type="revolute">
      <parent>gimbal_yaw_link</parent>
      <child>gimbal_roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <!-- A8 Mini: -30 a +30 graus. -->
        <limit><lower>-0.523598776</lower><upper>0.523598776</upper></limit>
        <dynamics><damping>0.02</damping><friction>0.005</friction></dynamics>
      </axis>
    </joint>

    <!-- 3. Pitch Link e Câmera -->
    <link name="camera_pitch_link">
      <pose>0.00057 -0.04216 -0.04551 0 0 0</pose>
      <inertial>
        <mass>0.055</mass>
        <inertia><ixx>0.0000363</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0000363</iyy><iyz>0</iyz><izz>0.0000277</izz></inertia>
      </inertial>
      
      <visual name="camera_visual">
        <!-- O eixo de pitch do Gazebo tem sinal oposto ao pitch aeronautico.
             Este offset mantem o STL na orientacao original quando o comando
             do gimbal e -90 graus (nadir). -->
        <pose degrees="true">0 0 0 0 -90 0</pose>
        <geometry><mesh><uri>model://drone_coaxial/meshes/camera-corrigida.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material>
          <ambient>0.015 0.015 0.015 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      
      <!-- Bounding box acompanha a mesma transformacao do STL. -->
      <collision name="camera_collision">
        <pose degrees="true">0 0 0 0 -90 0</pose>
        <geometry><box><size>0.055 0.055 0.070</size></box></geometry>
      </collision>

      <sensor name="siyi_a8_mini_sensor" type="camera">
        <!-- O eixo optico padrao da camera Gazebo e +X. O joint posiciona
             esse eixo em -90 graus e o mantem no referencial da Terra. -->
        <pose>0.04 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.4137</horizontal_fov>
          <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
          <clip><near>0.01</near><far>1000</far></clip>
          <distortion><k1>-0.05</k1><k2>0.01</k2><k3>0.0</k3><p1>0.0</p1><p2>0.0</p2><center>0.5 0.5</center></distortion>
        </camera>
        <always_on>1</always_on>
        <!-- Reduzido para não travar o PC -->
        <update_rate>5</update_rate>
        <visualize>true</visualize>
        <topic>camera/image</topic>
      </sensor>
    </link>
    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>gimbal_roll_link</parent>
      <child>camera_pitch_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Pitch aeronautico -135..+45 graus corresponde, pelo sinal do
             eixo Gazebo, a joint -45..+135 graus. -->
        <limit><lower>-0.785398163</lower><upper>2.356194490</upper></limit>
        <dynamics><damping>0.02</damping><friction>0.005</friction></dynamics>
      </axis>
    </joint>

    <!-- ============================================== -->
    <!-- ROTORES DO DRONE                               -->
    <!-- ============================================== -->

    <!-- BRAÇO 1 -->
    <link name="rotor_1_sup">
      <pose>0.40006 0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r1_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_sup_joint" type="revolute">
      <child>rotor_1_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_1_inf">
      <pose>0.40006 0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r1_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_1_inf_joint" type="revolute">
      <child>rotor_1_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- BRAÇO 2 -->
    <link name="rotor_2_sup">
      <pose>0.40006 -0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r2_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_sup_joint" type="revolute">
      <child>rotor_2_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_2_inf">
      <pose>0.40006 -0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r2_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_inf_joint" type="revolute">
      <child>rotor_2_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- BRAÇO 3 -->
    <link name="rotor_3_sup">
      <pose>-0.40006 0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r3_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_sup_joint" type="revolute">
      <child>rotor_3_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_3_inf">
      <pose>-0.40006 0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r3_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_inf_joint" type="revolute">
      <child>rotor_3_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- BRAÇO 4 -->
    <link name="rotor_4_sup">
      <pose>-0.40006 -0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r4_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_4_sup_joint" type="revolute">
      <child>rotor_4_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_4_inf">
      <pose>-0.40006 -0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r4_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_4_inf_joint" type="revolute">
      <child>rotor_4_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- TENDÕES (Obrigatório para o Gazebo aceitar força na joint) -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_4_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_4_inf_joint</joint_name></plugin>

    <!-- Aerodinamica calibrada para MN6007 II KV160 / 12S + P22x6.6.
         Ajuste LS da bancada T-Motor:
         T = 1.88928e-4 * omega^2 N; Q = 4.48871e-6 * omega^2 Nm.
         Cada plugin LiftDrag representa uma das duas pas da helice. -->
    
    <!-- ================= BRAÇO 1 (Frente-Esquerda) ================= -->
    <!-- SUP: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1_sup</link_name>
    </plugin>
    <!-- INF: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 2 (Frente-Direita) ================= -->
    <!-- SUP: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2_sup</link_name>
    </plugin>
    <!-- INF: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 3 (Atrás-Esquerda) ================= -->
    <!-- SUP: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3_sup</link_name>
    </plugin>
    <!-- INF: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 4 (Atrás-Direita) ================= -->
    <!-- SUP: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_4_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_4_sup</link_name>
    </plugin>
    <!-- INF: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_4_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_4_inf</link_name>
    </plugin>

    <!-- ArduPilot OctaQuad X. 5456 rpm = 571.35 rad/s no ponto de bancada
         de 100%; torque do eixo limitado pouco acima dos 1.49 Nm medidos. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <!-- Gazebo usa ENU; o SITL espera NED. O yaw de 90 graus alinha
           corretamente os eixos X/Y, como no modelo oficial Iris. -->
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <!-- C0: frente-direita superior, CCW -->
      <control channel="0"><jointName>rotor_2_sup_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C1: frente-esquerda superior, CW -->
      <control channel="1"><jointName>rotor_1_sup_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C2: traseira-esquerda superior, CCW -->
      <control channel="2"><jointName>rotor_3_sup_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C3: traseira-direita superior, CW -->
      <control channel="3"><jointName>rotor_4_sup_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C4: frente-esquerda inferior, CCW -->
      <control channel="4"><jointName>rotor_1_inf_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C5: frente-direita inferior, CW -->
      <control channel="5"><jointName>rotor_2_inf_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C6: traseira-direita inferior, CCW -->
      <control channel="6"><jointName>rotor_4_inf_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C7: traseira-esquerda inferior, CW -->
      <control channel="7"><jointName>rotor_3_inf_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
    
      <!-- Gimbal: PWM do Mount e convertido em setpoint angular. Os ganhos
           ficam nos JointPositionControllers abaixo, como no modelo oficial
           iris_with_gimbal do ardupilot_gazebo. -->

      <!-- Pitch ArduPilot -135..+45 graus -> joint Gazebo +135..-45 graus. -->
      <control channel="8">
        <jointName>gimbal_pitch_joint</jointName>
        <multiplier>-3.141592653589793</multiplier>
        <offset>-0.75</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/drone_coaxial/gimbal/cmd_pitch</cmd_topic>
      </control>

      <!-- Roll -30..+30 graus. -->
      <control channel="9">
        <jointName>gimbal_roll_joint</jointName>
        <multiplier>1.047197551196598</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/drone_coaxial/gimbal/cmd_roll</cmd_topic>
      </control>

      <!-- Yaw NED -160..+160 graus -> yaw ENU +160..-160 graus. -->
      <control channel="10">
        <jointName>gimbal_yaw_joint</jointName>
        <multiplier>-5.585053606381854</multiplier>
        <offset>-0.5</offset>
        <servo_min>1000</servo_min>
        <servo_max>2000</servo_max>
        <type>COMMAND</type>
        <cmd_topic>/drone_coaxial/gimbal/cmd_yaw</cmd_topic>
      </control>
    </plugin>

    <!-- Publica as posicoes reais para diagnostico e validacao do gimbal. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_pitch_joint</joint_name>
      <topic>/drone_coaxial/gimbal/cmd_pitch</topic>
      <initial_position>1.570796326794897</initial_position>
      <p_gain>2.0</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_roll_joint</joint_name>
      <topic>/drone_coaxial/gimbal/cmd_roll</topic>
      <initial_position>0</initial_position>
      <p_gain>2.0</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_yaw_joint</joint_name>
      <topic>/drone_coaxial/gimbal/cmd_yaw</topic>
      <initial_position>0</initial_position>
      <p_gain>2.0</p_gain>
    </plugin>
  </model>
</sdf>
