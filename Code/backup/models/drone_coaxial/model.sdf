      <child>rotor_2_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_2_inf">
      <pose>0.40006 -0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r2_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_2_inf_joint" type="revolute">
      <child>rotor_2_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- BRAÇO 3 -->
    <link name="rotor_3_sup">
      <pose>-0.40006 0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r3_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_3_sup_joint" type="revolute">
      <child>rotor_3_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_3_inf">
      <pose>-0.40006 0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r3_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
