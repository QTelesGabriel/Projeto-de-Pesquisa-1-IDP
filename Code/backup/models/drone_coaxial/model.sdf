      <child>rotor_3_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- BRAÇO 4 -->
    <link name="rotor_4_sup">
      <pose>-0.40006 -0.40476 0.09529 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r4_sup_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-sup-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_4_sup_joint" type="revolute">
      <child>rotor_4_sup</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
    <link name="rotor_4_inf">
      <pose>-0.40006 -0.40476 0.00581 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0005</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0005</iyy>
          <iyz>0.0</iyz>
          <izz>0.0005</izz>
        </inertia>
      </inertial>
      <visual name="r4_inf_vis">
        <geometry>
          <mesh>
            <uri>model://drone_coaxial/meshes/helice-inf-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>
    </link>
    <joint name="rotor_4_inf_joint" type="revolute">
      <child>rotor_4_inf</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- TENDÕES (Obrigatório para o Gazebo aceitar força na joint) -->
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_1_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_2_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_3_inf_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_4_sup_joint</joint_name></plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce"><joint_name>rotor_4_inf_joint</joint_name></plugin>

    <!-- Aerodinamica calibrada para MN6007 II KV160 / 12S + P22x6.6.
         Ajuste LS da bancada T-Motor:
         T = 1.88928e-4 * omega^2 N; Q = 4.48871e-6 * omega^2 Nm.
         Cada plugin LiftDrag representa uma das duas pas da helice. -->
    
    <!-- ================= BRAÇO 1 (Frente-Esquerda) ================= -->
    <!-- SUP: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1_sup</link_name>
    </plugin>
    <!-- INF: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_1_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_1_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 2 (Frente-Direita) ================= -->
    <!-- SUP: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2_sup</link_name>
    </plugin>
    <!-- INF: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_2_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_2_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 3 (Atrás-Esquerda) ================= -->
    <!-- SUP: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3_sup</link_name>
    </plugin>
    <!-- INF: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_3_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_3_inf</link_name>
    </plugin>

    <!-- ================= BRAÇO 4 (Atrás-Direita) ================= -->
    <!-- SUP: CW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_4_sup</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_4_sup</link_name>
    </plugin>
    <!-- INF: CCW -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>0.18 0 0</cp><forward>0 1 0</forward><upward>0 0 1</upward><link_name>rotor_4_inf</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0><alpha_stall>1.4</alpha_stall><cla>4.25</cla><cda>0.56097</cda><cma>0.0</cma><area>0.0037982</area><air_density>1.2041</air_density>
      <cp>-0.18 0 0</cp><forward>0 -1 0</forward><upward>0 0 1</upward><link_name>rotor_4_inf</link_name>
    </plugin>

    <!-- ArduPilot OctaQuad X. 5456 rpm = 571.35 rad/s no ponto de bancada
         de 100%; torque do eixo limitado pouco acima dos 1.49 Nm medidos. -->
    <plugin name="ArduPilotPlugin" filename="ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>

      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <!-- Gazebo usa ENU; o SITL espera NED. O yaw de 90 graus alinha
           corretamente os eixos X/Y, como no modelo oficial Iris. -->
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>imu_sensor</imuName>

      <!-- C0: frente-direita superior, CCW -->
      <control channel="0"><jointName>rotor_2_sup_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C1: frente-esquerda superior, CW -->
      <control channel="1"><jointName>rotor_1_sup_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C2: traseira-esquerda superior, CCW -->
      <control channel="2"><jointName>rotor_3_sup_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C3: traseira-direita superior, CW -->
      <control channel="3"><jointName>rotor_4_sup_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C4: frente-esquerda inferior, CCW -->
      <control channel="4"><jointName>rotor_1_inf_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C5: frente-direita inferior, CW -->
      <control channel="5"><jointName>rotor_2_inf_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C6: traseira-direita inferior, CCW -->
      <control channel="6"><jointName>rotor_4_inf_joint</jointName><useForce>1</useForce><multiplier>571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
      
      <!-- C7: traseira-esquerda inferior, CW -->
      <control channel="7"><jointName>rotor_3_inf_joint</jointName><useForce>1</useForce><multiplier>-571.35</multiplier><offset>0</offset><servo_min>1000</servo_min><servo_max>2000</servo_max><type>VELOCITY</type><p_gain>0.1</p_gain><i_gain>0</i_gain><d_gain>0</d_gain><i_max>0</i_max><i_min>0</i_min><cmd_max>1.6</cmd_max><cmd_min>-1.6</cmd_min><rotorVelocitySlowdownSim>1</rotorVelocitySlowdownSim></control>
    </plugin>
  </model>
</sdf>
