<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="armadilha_alvo">
    <static>false</static> 
    
    <link name="link">
      
      <!-- ========================================== -->
      <!-- MASSA E INÉRCIA (Convertidos para o SI)    -->
      <!-- ========================================== -->
      <inertial>
        <mass>4.81162</mass>
        <inertia>
          <!-- Valores principais mantidos -->
          <ixx>0.294868</ixx>
          <iyy>0.150069</iyy>
          <izz>0.258855</izz>
          
          <!-- Produtos de inércia zerados para evitar o Error 19 -->
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://armadilha/armadilha-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale> 
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://armadilha/armadilha-simplificado.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        
        <!-- ========================================== -->
        <!-- ATRITO COM O CHÃO (Para não escorregar)    -->
        <!-- ========================================== -->
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>100000</threshold>
          </bounce>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      
    </link>
  </model>
</sdf>