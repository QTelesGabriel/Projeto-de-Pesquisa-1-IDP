@article{lopezfranco2017,
   title = {Visual servoing for an autonomous hexarotor using a neural network based PID controller},
   author = {Lopez-Franco, Carlos and Gomez-Avila, Javier and Alanis, Alma Y. and Arana-Daniel, Nancy and Villase{\~n}or, Carlos},
   journal = {Sensors},
   volume = {17},
   number = {8},
   pages = {1865},
   year = {2017},
   month = {8},
   issn = {1424-8220},
   doi = {10.3390/s17081865},
   publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
   keywords = {Hexarotor, Unmanned aerial vehicle, Visual servoing},
   abstract = {In recent years, unmanned aerial vehicles (UAVs) have gained significant attention. However, we face two major drawbacks when working with UAVs: high nonlinearities and unknown position in 3D space since it is not provided with on-board sensors that can measure its position with respect to a global coordinate system. In this paper, we present a real-time implementation of a servo control, integrating vision sensors, with a neural proportional integral derivative (PID), in order to develop an hexarotor image based visual servo control (IBVS) that knows the position of the robot by using a velocity vector as a reference to control the hexarotor position. This integration requires a tight coordination between control algorithms, models of the system to be controlled, sensors, hardware and software platforms and well-defined interfaces, to allow the real-time implementation, as well as the design of different processing stages with their respective communication architecture. All of these issues and others provoke the idea that real-time implementations can be considered as a difficult task. For the purpose of showing the effectiveness of the sensor integration and control algorithm to address these issues on a high nonlinear system with noisy sensors as cameras, experiments were performed on the Asctec Firefly on-board computer, including both simulation and experimenta results.}
}
@unpublished{shaikh2024,
   title = {Machine Learning in Aerial Manipulation: A Survey},
   author = {Shaikh, Shayaan and Amiri, Niloufar and Janabi-Sharifi, Farrokh},
   year = {2024},
   note = {Preprint disponível em SSRN: 4894982},
   url = {https://ssrn.com/abstract=6666693},
   keywords = {aerial manipulation, learning-based control, machine learning, object detection, visual servoing},
   abstract = {This survey reviews recent implementations of rapidly advancing machine learning (ML) techniques in aerial manipulation systems (AMSs). The considered platforms comprise uncrewed aerial vehicles (UAVs) serving as the aerial base, equipped with manipulation systems ranging from rigid to compliant and continuum arms. A key contribution of this work is the unified treatment of this diverse set of manipulation platforms, which has not been systematically explored in prior surveys. The primary focus is on studies that integrate ML into perception, modeling, and control, either as standalone modules or within hybrid frameworks. The surveyed algorithms are comparatively analyzed with respect to conventional approaches, and open challenges and future research directions are identified.}
}
@article{adegun2024,
   title = {Ontology-Based Deep Learning Model for Object Detection and Image Classification in Smart City Concepts},
   author = {Adegun, Adekanmi Adeyinka and Fonou-Dombeu, Jean Vincent and Viriri, Serestina and Odindi, John},
   journal = {Smart Cities},
   volume = {7},
   number = {4},
   pages = {2182--2207},
   year = {2024},
   month = {8},
   issn = {2624-6511},
   doi = {10.3390/smartcities7040086},
   publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
   keywords = {YOLO, deep learning, image analysis, knowledge representation, object detection, ontology, remote sensing, satellite images, smart city, urban planning},
   abstract = {Object detection in remotely sensed (RS) satellite imagery has gained significance in smart city concepts, which include urban planning, disaster management, and environmental monitoring. Deep learning techniques have shown promising outcomes in object detection and scene classification from RS satellite images, surpassing traditional methods that are reliant on hand-crafted features. However, these techniques lack the ability to provide in-depth comprehension of RS images and enhanced interpretation for analyzing intricate urban objects with functional structures and environmental contexts. To address this limitation, this study proposes a framework that integrates a deep learning-based object detection algorithm with ontology models for effective knowledge representation and analysis. The framework can automatically and accurately detect objects and classify scenes in remotely sensed satellite images and also perform semantic description and analysis of the classified scenes. The framework combines a knowledge-guided ontology reasoning module into a YOLOv8 objects detection model. This study demonstrates that the proposed framework can detect objects in varying environmental contexts captured using a remote sensing satellite device and incorporate efficient knowledge representation and inferences with a less-complex ontology model.}
}
@inproceedings{barisic2019,
   title = {Vision-based system for a real-time detection and following of UAV},
   author = {Bari{\v{s}}i{\'c}, Antun and Car, Marko and Bogdan, Stjepan},
   booktitle = {Proceedings of the 2019 Workshop on Research, Education and Development of Unmanned Aerial Systems (RED UAS)},
   year = {2019},
